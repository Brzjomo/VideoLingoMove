# 项目内缓存：uv / pip 下载缓存（环境大升级后由 setup_env.py 使用，可随时删）
/.uv-cache/
/.pip-cache/
# 大文件下载目录：torch 轮子（单个 2.7-3.6 GB）、FFmpeg 压缩包、pip download 产物。
# 存在的意义是"下载与安装分离"——网络不佳时可用外部工具下好放进来。
/_downloads/
# 项目内 FFmpeg（installer.py 下载的版本，体积大且平台相关）
/ffmpeg/
# 安装状态指纹（放在环境目录里，这里兜底防漏）
.videolingo-install.json
# 转录内容寻址缓存（core/all_whisper_methods/transcription_cache.py）。
# 故意放在 output/ 之外，这样归档/清理 output 不会让它失效。
/.cache/

# launch.py 的运行日志目录
logs/

batch/input/
batch/output/
# 上一批产物的归档目录（batch/utils/gui.py 自动创建），也不入库
batch/output_archive_*/
# 运行期任务表：每次「创建/更新任务配置」都从 tasks_setting-template.xlsx 复制生成，不入库
batch/tasks_setting.xlsx

# 本地配置（含真实密钥）。模板 config.example.yaml 需要提交，因此这里只忽略 config.yaml 本身。
config.yaml
config.yaml.local-backup

